---
// src/components/DownloaderApp.astro
---

<div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-20">
  <!-- Mesh Gradient Bloom (DESIGN.md Hero Accent) -->
  <div class="mesh-gradient-hero" aria-hidden="true"></div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center max-w-2xl mx-auto mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ffffff] border border-[#ebebeb] text-[#171717] mb-5 shadow-xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3]"></span>
      <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">Direct Stream Extraction</span>
    </div>

    <h1 class="display-xl text-[#171717] mb-4">
      Paste a YouTube link.<br />Download clean media.
    </h1>

    <p class="text-sm sm:text-base text-[#4d4d4d] leading-relaxed max-w-lg mx-auto">
      Access available video and audio streams with zero ads, no accounts, and direct browser download prompts.
    </p>
  </div>

  <!-- Input Form Container -->
  <div class="relative z-10 mb-6">
    <form id="url-form" class="w-full" onsubmit="return false;">
      <div class="bg-white border border-[#ebebeb] hover:border-[#a1a1a1] focus-within:border-[#171717] focus-within:ring-1 focus-within:ring-[#171717] transition-all rounded-2xl p-2 shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
        <!-- Input Field & Icons -->
        <div class="flex items-center flex-1 min-w-0 px-3 py-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#8f8f8f] shrink-0 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>

          <input
            id="url-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="Paste YouTube URL here (e.g. https://www.youtube.com/watch?v=...)"
            class="w-full bg-transparent border-none text-[#171717] text-sm sm:text-base placeholder-[#8f8f8f] focus:outline-none focus:ring-0"
          />

          <!-- Clear Button (hidden by default) -->
          <button
            id="clear-btn"
            type="button"
            class="hidden p-1 rounded-md text-[#8f8f8f] hover:text-[#171717] transition-colors shrink-0"
            title="Clear input"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center gap-2 shrink-0 px-1">
          <!-- Paste Clipboard Button -->
          <button
            id="paste-btn"
            type="button"
            class="px-3.5 py-2 rounded-xl border border-[#ebebeb] bg-[#fafafa] hover:bg-[#f2f2f2] text-xs font-medium text-[#171717] flex items-center gap-1.5 transition-colors cursor-pointer"
            title="Paste from clipboard"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#4d4d4d]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            </svg>
            <span class="hidden sm:inline">Paste</span>
          </button>

          <!-- Submit Button (Marketing Pill) -->
          <button
            id="submit-btn"
            type="submit"
            class="flex-1 sm:flex-initial px-6 py-2.5 rounded-xl bg-[#171717] hover:bg-black text-white text-sm font-medium tracking-tight transition-all active:scale-[0.98] flex items-center justify-center gap-2 shadow-xs cursor-pointer"
          >
            <span id="submit-btn-text">Fetch Options</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </form>

    <!-- Quick Sample Links -->
    <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs text-[#8f8f8f]">
      <span>Quick sample:</span>
      <button
        type="button"
        class="sample-link font-mono hover:text-[#171717] underline decoration-[#ebebeb] hover:decoration-[#171717] transition-colors cursor-pointer"
        data-url="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      >
        Rick Astley (Remaster)
      </button>
      <span>•</span>
      <button
        type="button"
        class="sample-link font-mono hover:text-[#171717] underline decoration-[#ebebeb] hover:decoration-[#171717] transition-colors cursor-pointer"
        data-url="https://www.youtube.com/watch?v=aqz-KE-bpKQ"
      >
        Big Buck Bunny (4K 60fps)
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="loading-container" class="hidden relative z-10 my-8">
    <div class="bg-white border border-[#ebebeb] rounded-2xl p-8 text-center max-w-lg mx-auto shadow-xs">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[#f2f2f2] text-[#171717] mb-4">
        <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <h3 class="text-base font-semibold text-[#171717] mb-1">Inspecting Video Streams</h3>
      <p class="text-xs text-[#8f8f8f] leading-relaxed">
        Querying YouTube InnerTube manifests, deciphering video URLs and resolving format availability...
      </p>
    </div>
  </div>

  <!-- Error State Alert -->
  <div id="error-container" class="hidden relative z-10 my-6">
    <div class="bg-[#fff5f5] border border-[#fecaca] rounded-2xl p-4 sm:p-5 flex items-start gap-3 text-left">
      <div class="w-8 h-8 rounded-full bg-[#fee2e2] flex items-center justify-center text-[#ee0000] shrink-0 mt-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div class="flex-1">
        <h4 class="text-sm font-semibold text-[#991b1b]" id="error-title">Unable to Process Video</h4>
        <p class="text-xs text-[#b91c1c] mt-1 leading-relaxed" id="error-message">
          Please check the URL and ensure the video is publicly available.
        </p>
      </div>
      <button
        id="dismiss-error-btn"
        type="button"
        class="text-[#991b1b] hover:text-[#7f1d1d] p-1 rounded-md text-xs font-mono"
      >
        Dismiss
      </button>
    </div>
  </div>

  <!-- Result Container (Video Details & Formats) -->
  <div id="result-container" class="hidden relative z-10 my-8">
    <div class="bg-white border border-[#ebebeb] rounded-2xl shadow-xs overflow-hidden">
      <!-- Video Metadata Header -->
      <div class="p-6 sm:p-8 border-b border-[#ebebeb]">
        <div class="flex flex-col md:flex-row gap-6 items-start">
          <!-- Thumbnail with Duration Badge -->
          <div class="relative w-full md:w-72 aspect-video rounded-xl overflow-hidden bg-[#f2f2f2] border border-[#ebebeb] shrink-0">
            <img
              id="video-thumbnail"
              src=""
              alt="Video thumbnail"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div
              id="video-duration"
              class="absolute bottom-2 right-2 bg-black/80 backdrop-blur-xs text-white text-[11px] font-mono px-2 py-0.5 rounded-md font-medium"
            >
              0:00
            </div>
          </div>

          <!-- Title, Channel, & Stats -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <span class="mono-eyebrow text-[10px] text-[#0070f3] bg-[#d3e5ff]/50 px-2 py-0.5 rounded">Ready for Download</span>
              <span id="video-id-badge" class="font-mono text-xs text-[#8f8f8f]"></span>
            </div>

            <h2 id="video-title" class="text-lg sm:text-xl font-semibold text-[#171717] tracking-tight leading-snug mb-3">
              Video Title
            </h2>

            <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-[#4d4d4d] mb-4">
              <div class="flex items-center gap-1.5 font-medium text-[#171717]">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#8f8f8f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span id="video-author">Channel Name</span>
              </div>

              <div class="flex items-center gap-1.5 text-[#8f8f8f]">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span id="video-views">0 views</span>
              </div>
            </div>

            <a
              id="video-watch-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-[#0070f3] hover:underline"
            >
              <span>Open on YouTube</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Format Tabs & Options -->
      <div class="p-6 sm:p-8 bg-[#fafafa]">
        <!-- Category Pill Tabs (DESIGN.md) -->
        <div class="flex items-center gap-2 mb-6">
          <button
            id="tab-video"
            type="button"
            class="format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-[#171717] text-white transition-all cursor-pointer shadow-xs"
            data-target="video-list"
          >
            Video Streams (MP4)
          </button>
          <button
            id="tab-audio"
            type="button"
            class="format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-white border border-[#ebebeb] text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer"
            data-target="audio-list"
          >
            Audio Only (M4A / WebM)
          </button>
        </div>

        <!-- Video Formats List -->
        <div id="video-list" class="space-y-3">
          <!-- Populated by client script -->
        </div>

        <!-- Audio Formats List -->
        <div id="audio-list" class="space-y-3 hidden">
          <!-- Populated by client script -->
        </div>

        <!-- Download status banner -->
        <div id="download-progress-banner" class="hidden mt-6 p-3 rounded-xl bg-[#d3e5ff]/50 border border-[#b8d6ff] text-xs text-[#0761d1] flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="animate-spin h-3.5 w-3.5 text-[#0070f3]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="download-status-text">Streaming file to your browser...</span>
          </div>
          <span class="font-mono text-[11px] text-[#0761d1]">Check downloads bar</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Feature Value Props Strip (DESIGN.md feature-cards) -->
  <div class="relative z-10 grid grid-cols-1 sm:grid-cols-3 gap-4 mt-12">
    <div class="bg-white border border-[#ebebeb] rounded-xl p-5 shadow-xs">
      <div class="w-8 h-8 rounded-lg bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-[#171717] mb-1">Direct Stream Piping</h3>
      <p class="text-xs text-[#4d4d4d] leading-relaxed">
        Streams media chunks directly from YouTube CDN to your browser without long server buffering delays.
      </p>
    </div>

    <div class="bg-white border border-[#ebebeb] rounded-xl p-5 shadow-xs">
      <div class="w-8 h-8 rounded-lg bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-[#171717] mb-1">Format Flexibility</h3>
      <p class="text-xs text-[#4d4d4d] leading-relaxed">
        Select between progressive MP4 video streams or high-bitrate AAC/M4A audio tracks with clear size estimates.
      </p>
    </div>

    <div class="bg-white border border-[#ebebeb] rounded-xl p-5 shadow-xs">
      <div class="w-8 h-8 rounded-lg bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-[#171717] mb-1">Zero Tracking</h3>
      <p class="text-xs text-[#4d4d4d] leading-relaxed">
        No accounts, no user databases, no persistent logs, and no third-party advertising scripts.
      </p>
    </div>
  </div>
</div>

<script>
  // Client-side controller
  let currentVideoData = null;

  const urlInput = document.getElementById('url-input');
  const clearBtn = document.getElementById('clear-btn');
  const pasteBtn = document.getElementById('paste-btn');
  const urlForm = document.getElementById('url-form');
  const submitBtn = document.getElementById('submit-btn');
  const submitBtnText = document.getElementById('submit-btn-text');

  const loadingContainer = document.getElementById('loading-container');
  const errorContainer = document.getElementById('error-container');
  const errorTitle = document.getElementById('error-title');
  const errorMessage = document.getElementById('error-message');
  const dismissErrorBtn = document.getElementById('dismiss-error-btn');

  const resultContainer = document.getElementById('result-container');
  const videoThumbnail = document.getElementById('video-thumbnail');
  const videoDuration = document.getElementById('video-duration');
  const videoTitle = document.getElementById('video-title');
  const videoAuthor = document.getElementById('video-author');
  const videoViews = document.getElementById('video-views');
  const videoIdBadge = document.getElementById('video-id-badge');
  const videoWatchLink = document.getElementById('video-watch-link');

  const tabVideo = document.getElementById('tab-video');
  const tabAudio = document.getElementById('tab-audio');
  const videoList = document.getElementById('video-list');
  const audioList = document.getElementById('audio-list');
  const downloadProgressBanner = document.getElementById('download-progress-banner');
  const downloadStatusText = document.getElementById('download-status-text');

  // Input events
  urlInput.addEventListener('input', () => {
    clearBtn.classList.toggle('hidden', !urlInput.value.trim());
  });

  clearBtn.addEventListener('click', () => {
    urlInput.value = '';
    clearBtn.classList.add('hidden');
    urlInput.focus();
  });

  // Paste button
  pasteBtn.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text) {
        urlInput.value = text.trim();
        clearBtn.classList.remove('hidden');
        processUrl(urlInput.value);
      }
    } catch (err) {
      // Clipboard permission denied or unsupported
      urlInput.focus();
    }
  });

  // Form submit
  urlForm.addEventListener('submit', (e) => {
    e.preventDefault();
    processUrl(urlInput.value);
  });

  // Quick sample links
  document.querySelectorAll('.sample-link').forEach((link) => {
    link.addEventListener('click', () => {
      const url = link.getAttribute('data-url');
      if (url) {
        urlInput.value = url;
        clearBtn.classList.remove('hidden');
        processUrl(url);
      }
    });
  });

  // Dismiss error
  dismissErrorBtn.addEventListener('click', () => {
    errorContainer.classList.add('hidden');
  });

  // Format tab switching
  tabVideo.addEventListener('click', () => {
    tabVideo.className = 'format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-[#171717] text-white transition-all cursor-pointer shadow-xs';
    tabAudio.className = 'format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-white border border-[#ebebeb] text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer';
    videoList.classList.remove('hidden');
    audioList.classList.add('hidden');
  });

  tabAudio.addEventListener('click', () => {
    tabAudio.className = 'format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-[#171717] text-white transition-all cursor-pointer shadow-xs';
    tabVideo.className = 'format-tab px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-white border border-[#ebebeb] text-[#4d4d4d] hover:text-[#171717] transition-all cursor-pointer';
    audioList.classList.remove('hidden');
    videoList.classList.add('hidden');
  });

  // Fetch video details
  async function processUrl(input) {
    const trimmed = (input || '').trim();
    if (!trimmed) {
      showError('Input Required', 'Please paste a valid YouTube video URL or ID.');
      urlInput.focus();
      return;
    }

    // Reset states
    hideError();
    resultContainer.classList.add('hidden');
    loadingContainer.classList.remove('hidden');
    submitBtn.disabled = true;
    submitBtnText.textContent = 'Processing...';

    try {
      const res = await fetch(`/api/info?url=${encodeURIComponent(trimmed)}`);
      const json = await res.json();

      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to retrieve video information.');
      }

      currentVideoData = json.data;
      renderVideoResult(currentVideoData);
    } catch (err) {
      showError('Extraction Error', err.message || 'An unexpected error occurred while processing the video.');
    } finally {
      loadingContainer.classList.add('hidden');
      submitBtn.disabled = false;
      submitBtnText.textContent = 'Fetch Options';
    }
  }

  function renderVideoResult(data) {
    videoThumbnail.src = data.thumbnailUrl;
    videoDuration.textContent = data.durationFormatted;
    videoTitle.textContent = data.title;
    videoAuthor.textContent = data.author;
    videoViews.textContent = data.viewCountFormatted;
    videoIdBadge.textContent = `ID: ${data.id}`;
    videoWatchLink.href = data.url;

    // Render Video Formats
    videoList.innerHTML = '';
    const videoFormats = data.formats.video || [];

    if (videoFormats.length === 0) {
      videoList.innerHTML = `
        <div class="p-4 rounded-xl bg-white border border-[#ebebeb] text-xs text-[#8f8f8f] text-center">
          No direct progressive video streams available for this video. Please check the Audio tab or try another video.
        </div>
      `;
    } else {
      videoFormats.forEach((fmt) => {
        const item = document.createElement('div');
        item.className = 'bg-white border border-[#ebebeb] hover:border-[#171717]/30 transition-all rounded-xl p-3.5 sm:p-4 flex items-center justify-between gap-4 shadow-xs';
        item.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                <line x1="7" y1="2" x2="7" y2="22"></line>
                <line x1="17" y1="2" x2="17" y2="22"></line>
                <line x1="2" y1="12" x2="22" y2="12"></line>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-[#171717]">${fmt.quality}</span>
                <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-[#f2f2f2] text-[#4d4d4d] border border-[#ebebeb]">${fmt.container}</span>
              </div>
              <div class="text-xs text-[#8f8f8f] mt-0.5">
                ${fmt.approxSizeMb ? `~ ${fmt.approxSizeMb} MB` : 'Direct stream'} • Progressive (Audio + Video)
              </div>
            </div>
          </div>

          <button
            type="button"
            class="download-action-btn shrink-0 px-4 py-2 rounded-xl bg-[#171717] hover:bg-black text-white text-xs font-medium tracking-tight transition-all active:scale-[0.98] flex items-center gap-1.5 shadow-xs cursor-pointer"
            data-itag="${fmt.itag}"
            data-type="video"
            data-title="${encodeURIComponent(data.title)}"
          >
            <span>Download</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </button>
        `;
        videoList.appendChild(item);
      });
    }

    // Render Audio Formats
    audioList.innerHTML = '';
    const audioFormats = data.formats.audio || [];

    if (audioFormats.length === 0) {
      audioList.innerHTML = `
        <div class="p-4 rounded-xl bg-white border border-[#ebebeb] text-xs text-[#8f8f8f] text-center">
          No separate audio streams found.
        </div>
      `;
    } else {
      audioFormats.forEach((fmt) => {
        const item = document.createElement('div');
        item.className = 'bg-white border border-[#ebebeb] hover:border-[#171717]/30 transition-all rounded-xl p-3.5 sm:p-4 flex items-center justify-between gap-4 shadow-xs';
        item.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#171717] shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-[#171717]">${fmt.quality}</span>
                <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-[#f2f2f2] text-[#4d4d4d] border border-[#ebebeb]">${fmt.container}</span>
              </div>
              <div class="text-xs text-[#8f8f8f] mt-0.5">
                ${fmt.approxSizeMb ? `~ ${fmt.approxSizeMb} MB` : 'Audio track'} • Original Bitrate
              </div>
            </div>
          </div>

          <button
            type="button"
            class="download-action-btn shrink-0 px-4 py-2 rounded-xl bg-[#171717] hover:bg-black text-white text-xs font-medium tracking-tight transition-all active:scale-[0.98] flex items-center gap-1.5 shadow-xs cursor-pointer"
            data-itag="${fmt.itag}"
            data-type="audio"
            data-title="${encodeURIComponent(data.title)}"
          >
            <span>Download</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </button>
        `;
        audioList.appendChild(item);
      });
    }

    // Attach click listeners to download buttons
    document.querySelectorAll('.download-action-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const itag = btn.getAttribute('data-itag');
        const type = btn.getAttribute('data-type');
        triggerDownload(data.id, itag, type);
      });
    });

    resultContainer.classList.remove('hidden');
    resultContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function triggerDownload(id, itag, type) {
    downloadProgressBanner.classList.remove('hidden');
    downloadStatusText.textContent = 'Contacting YouTube CDN & transferring stream...';

    // Direct browser download prompt via download URL
    const downloadUrl = `/api/download?id=${encodeURIComponent(id)}&itag=${encodeURIComponent(itag)}&type=${encodeURIComponent(type)}`;

    // Create an invisible download anchor to trigger native save dialog
    const a = document.createElement('a');
    a.href = downloadUrl;
    a.setAttribute('download', '');
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);

    // Keep banner informative
    setTimeout(() => {
      downloadStatusText.textContent = 'Stream requested! Check your browser downloads.';
    }, 2500);

    setTimeout(() => {
      downloadProgressBanner.classList.add('hidden');
    }, 10000);
  }

  function showError(title, msg) {
    errorTitle.textContent = title;
    errorMessage.textContent = msg;
    errorContainer.classList.remove('hidden');
  }

  function hideError() {
    errorContainer.classList.add('hidden');
  }
</script>

