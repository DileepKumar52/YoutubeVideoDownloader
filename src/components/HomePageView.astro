---
// src/components/HomePageView.astro
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import DownloaderApp from './DownloaderApp.astro';
import HomeContent from './HomeContent.astro';
import FaqSection from './FaqSection.astro';
import Footer from './Footer.astro';
import {
  type SupportedLocale,
  DEFAULT_LOCALE,
  getLocalizedPath,
} from '../i18n/locales';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const canonicalUrl = `https://youtubevideodownloader.app${getLocalizedPath('/', locale)}`;

// Localized Structured Data
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t.nav.brand,
  url: canonicalUrl,
  description: t.meta.home.description,
  inLanguage: locale,
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t.nav.brand,
  url: canonicalUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'All (Web Browser, Windows, macOS, Linux, iOS, Android)',
  inLanguage: locale,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    '1080p Full HD video download with synchronized audio',
    'High-bitrate audio extraction (M4A / AAC)',
    'Zero ads, popups, or user account requirements',
    'Lossless real-time stream remuxing',
    'Compatible with desktop, Android, and iPhone Safari',
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: t.faqs.items.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const homepageJsonLd = [websiteJsonLd, webAppJsonLd, faqJsonLd];
---

<Layout
  title={t.meta.home.title}
  description={t.meta.home.description}
  canonicalUrl={canonicalUrl}
  jsonLd={homepageJsonLd}
  locale={locale}
>
  <Navbar locale={locale} />
  <main class="flex-1 flex flex-col justify-start">
    <DownloaderApp locale={locale} />
    <HomeContent locale={locale} />
    <FaqSection locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

