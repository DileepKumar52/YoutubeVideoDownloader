---
// src/components/HomeContent.astro
import {
  type SupportedLocale,
  DEFAULT_LOCALE,
} from '../i18n/locales';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const g = t.guide;
---

<article class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-12 text-[#171717] border-t border-[#ebebeb]">
  <!-- Header Eyebrow -->
  <div class="mb-10 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ffffff] border border-[#ebebeb] text-[#171717] mb-3 shadow-xs">
      <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">{g.eyebrow}</span>
    </div>
    <h2 class="heading-lg text-[#171717]">
      {g.mainTitle}
    </h2>
    <p class="text-sm text-[#8f8f8f] mt-2">
      {g.mainSubtitle}
    </p>
  </div>

  <div class="space-y-12 leading-relaxed text-sm sm:text-base text-[#4d4d4d]">
    <!-- 1. Introduction -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">1</div>
        <h3 class="heading-md text-[#171717]">{g.sec1Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec1P1}
      </p>
      <p>
        {g.sec1P2}
      </p>
    </section>

    <!-- 2. How the Downloader Works -->
    <section id="how-it-works" class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs scroll-mt-20">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">2</div>
        <h3 class="heading-md text-[#171717]">{g.sec2Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec2P1}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
        <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
          <h4 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">{g.sec2Card1Title}</h4>
          <p class="text-xs text-[#8f8f8f] leading-normal">
            {g.sec2Card1Desc}
          </p>
        </div>
        <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
          <h4 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">{g.sec2Card2Title}</h4>
          <p class="text-xs text-[#8f8f8f] leading-normal">
            {g.sec2Card2Desc}
          </p>
        </div>
      </div>
      <p>
        {g.sec2P2}
      </p>
    </section>

    <!-- 3. Available Quality and Resolution -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">3</div>
        <h3 class="heading-md text-[#171717]">{g.sec3Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec3P1}
      </p>
      <ul class="space-y-3 my-4">
        {g.sec3Tiers.map((tier) => (
          <li class="flex items-start gap-3">
            <span class="inline-block mt-1 w-2 h-2 rounded-full bg-[#171717] shrink-0"></span>
            <div>
              <strong class="text-[#171717] text-sm">{tier.title}</strong>
              <span class="text-xs text-[#8f8f8f] block mt-0.5">
                {tier.desc}
              </span>
            </div>
          </li>
        ))}
      </ul>
      <p class="text-xs text-[#8f8f8f]">
        <em>{g.sec3Note}</em>
      </p>
    </section>

    <!-- 4. Supported Formats -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">4</div>
        <h3 class="heading-md text-[#171717]">{g.sec4Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec4P1}
      </p>
      <div class="space-y-4">
        <div class="border-l-2 border-[#171717] pl-4">
          <h4 class="text-sm font-semibold text-[#171717]">{g.sec4Fmt1Title}</h4>
          <p class="text-xs text-[#8f8f8f] mt-1 leading-normal">
            {g.sec4Fmt1Desc}
          </p>
        </div>
        <div class="border-l-2 border-[#0070f3] pl-4">
          <h4 class="text-sm font-semibold text-[#171717]">{g.sec4Fmt2Title}</h4>
          <p class="text-xs text-[#8f8f8f] mt-1 leading-normal">
            {g.sec4Fmt2Desc}
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Desktop and Mobile Device Guide -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">5</div>
        <h3 class="heading-md text-[#171717]">{g.sec5Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec5P1}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
        <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
          <h4 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-2 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            {g.sec5DesktopTitle}
          </h4>
          <ol class="text-xs text-[#4d4d4d] space-y-1.5 list-decimal list-inside leading-relaxed">
            {g.sec5DesktopSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>

        <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
          <h4 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-2 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
            {g.sec5MobileTitle}
          </h4>
          <ol class="text-xs text-[#4d4d4d] space-y-1.5 list-decimal list-inside leading-relaxed">
            {g.sec5MobileSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 6. Browser Compatibility -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">6</div>
        <h3 class="heading-md text-[#171717]">{g.sec6Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec6P1}
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        {g.sec6Browsers.map((b) => (
          <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <div class="text-xs font-semibold text-[#171717]">{b.name}</div>
            <div class="text-[11px] text-[#8f8f8f] mt-0.5">{b.platforms}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. Troubleshooting -->
    <section id="troubleshooting" class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs scroll-mt-20">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">7</div>
        <h3 class="heading-md text-[#171717]">{g.sec7Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec7P1}
      </p>

      <div class="space-y-3">
        {g.sec7Issues.map((issue) => (
          <div class="p-3.5 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <h4 class="text-xs font-semibold text-[#171717]">{issue.title}</h4>
            <p class="text-xs text-[#8f8f8f] mt-1 leading-relaxed">
              {issue.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. Privacy & Responsible Usage -->
    <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-7 h-7 rounded-md bg-[#171717] text-white flex items-center justify-center font-mono text-xs font-semibold">8</div>
        <h3 class="heading-md text-[#171717]">{g.sec8Title}</h3>
      </div>
      <p class="mb-4">
        {g.sec8P1}
      </p>
      <p class="text-xs text-[#8f8f8f] leading-relaxed">
        <strong>{g.sec8NoticeTitle}</strong> {g.sec8NoticeDesc}
      </p>
    </section>
  </div>
</article>
