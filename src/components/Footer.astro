---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#ebebeb] bg-[#fafafa] py-12 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Clean 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-[#ebebeb]">
      <!-- Logo Section -->
      <div class="md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 text-[#171717] font-semibold tracking-tight hover:opacity-90 transition-opacity">
          <div class="w-7 h-7 rounded-md bg-[#171717] flex items-center justify-center text-white text-xs shrink-0 shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 ml-0.5" aria-hidden="true">
              <path d="M8 5.14v14l11-7-11-7z" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-[#171717]">YouTube Video Downloader</span>
        </a>
      </div>

      <!-- Product & Tools -->
      <div class="space-y-3">
        <div class="mono-eyebrow text-[11px] text-[#171717]">Product & Tools</div>
        <ul class="space-y-2 text-xs text-[#4d4d4d]">
          <li>
            <a href="/" class="hover:text-[#171717] transition-colors">YouTube Video Downloader</a>
          </li>
          <li>
            <a href="/#downloader" class="hover:text-[#171717] transition-colors">1080p Full HD Tool</a>
          </li>
          <li>
            <a href="/#downloader" class="hover:text-[#171717] transition-colors">Audio Extractor (MP4 / M4A)</a>
          </li>
        </ul>
      </div>

      <!-- Information -->
      <div class="space-y-3">
        <div class="mono-eyebrow text-[11px] text-[#171717]">Information</div>
        <ul class="space-y-2 text-xs text-[#4d4d4d]">
          <li>
            <a href="/about" class="hover:text-[#171717] transition-colors">About Us</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-[#171717] transition-colors">Contact Us & Support</a>
          </li>
        </ul>
      </div>

      <!-- Legal & Compliance -->
      <div class="space-y-3">
        <div class="mono-eyebrow text-[11px] text-[#171717]">Legal & Compliance</div>
        <ul class="space-y-2 text-xs text-[#4d4d4d]">
          <li>
            <a href="/privacy" class="hover:text-[#171717] transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="hover:text-[#171717] transition-colors">Terms of Service</a>
          </li>
          <li>
            <a href="/disclaimer" class="hover:text-[#171717] transition-colors">Legal Disclaimer</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright Only -->
    <div class="pt-6 flex items-center justify-between text-xs text-[#8f8f8f]">
      <div>
        &copy; {currentYear} YouTube Video Downloader. All rights reserved.
      </div>
    </div>
  </div>
</footer>
