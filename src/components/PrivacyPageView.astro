---
// src/components/PrivacyPageView.astro
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import {
  type SupportedLocale,
  DEFAULT_LOCALE,
  getLocalizedPath,
} from '../i18n/locales';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const p = t.privacy;
const canonicalUrl = `https://youtubevideodownloader.app${getLocalizedPath('/privacy', locale)}`;
---

<Layout
  title={t.meta.privacy.title}
  description={t.meta.privacy.description}
  canonicalUrl={canonicalUrl}
  locale={locale}
>
  <Navbar locale={locale} />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 w-full">
    <!-- Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] text-[#171717] mb-3 shadow-xs">
        <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">{p.eyebrow}</span>
      </div>
      <h1 class="heading-lg text-[#171717] mb-2">
        {p.title}
      </h1>
      <p class="text-xs text-[#8f8f8f]">
        Last updated: {p.lastUpdated}
      </p>
    </div>

    <!-- Content Sections -->
    <div class="space-y-6 text-xs sm:text-sm text-[#4d4d4d] leading-relaxed">
      {p.sections.map((section) => (
        <div class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
          <h2 class="text-base font-semibold text-[#171717]">{section.title}</h2>
          <p>{section.content}</p>
          {section.list && (
            <ul class="space-y-2 list-disc list-inside text-xs text-[#4d4d4d]">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
</Layout>

