---
// src/components/FaqSection.astro
import {
  type SupportedLocale,
  DEFAULT_LOCALE,
  getLocalizedPath,
} from '../i18n/locales';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const f = t.faqs;

const contactUrl = getLocalizedPath('/contact', locale);
const aboutUrl = getLocalizedPath('/about', locale);
---

<section id="faq" class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-16 scroll-mt-14 border-t border-[#ebebeb]">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ffffff] border border-[#ebebeb] text-[#171717] mb-3 shadow-xs">
      <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">{f.eyebrow}</span>
    </div>
    <h2 class="heading-lg text-[#171717]">
      {f.title}
    </h2>
    <p class="text-sm text-[#8f8f8f] mt-2">
      {f.subtitle}
    </p>
  </div>

  <div class="space-y-3">
    {f.items.map((faq, index) => (
      <details
        class="faq-item group bg-white border border-[#ebebeb] hover:border-[#171717]/30 rounded-xl transition-all shadow-xs overflow-hidden"
        id={`faq-item-${index}`}
      >
        <summary class="flex items-center justify-between gap-4 p-4 sm:p-5 cursor-pointer select-none text-left font-medium text-sm sm:text-base text-[#171717] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0070f3] rounded-xl list-none">
          <span class="flex items-center gap-3">
            <span class="font-mono text-xs text-[#8f8f8f] shrink-0">0{index + 1}</span>
            <span>{faq.question}</span>
          </span>
          <span class="w-6 h-6 rounded-md bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[#8f8f8f] group-open:rotate-180 transition-transform duration-200 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="px-4 pb-5 sm:px-5 sm:pb-6 pt-1 text-xs sm:text-sm text-[#4d4d4d] leading-relaxed border-t border-[#f2f2f2] mt-1">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>

  <div class="mt-8 text-center">
    <p class="text-xs text-[#8f8f8f]">
      {f.footerText} <a href={contactUrl} class="text-[#0070f3] hover:underline font-medium">{f.contactLinkText}</a> or <a href={aboutUrl} class="text-[#0070f3] hover:underline font-medium">{f.aboutLinkText}</a>.
    </p>
  </div>
</section>

<style>
  /* Remove default arrow in Chrome/Safari/Firefox */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
