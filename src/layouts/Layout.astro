---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'YouTube Video & Audio Downloader — Fast, Direct & Clean',
  description = 'Paste any YouTube URL and download available video or audio formats directly. Zero ads, no account required.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-[#fafafa]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" />

    <!-- Google Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-full flex flex-col bg-[#fafafa] text-[#171717] antialiased selection:bg-[#d3e5ff] selection:text-[#0070f3]">
    <slot />
  </body>
</html>
