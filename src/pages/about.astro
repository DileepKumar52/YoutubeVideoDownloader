---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About StreamFetch',
  description: 'Learn about StreamFetch, our mission to provide clean, fast, and privacy-conscious YouTube video downloading and media extraction without ads.',
  url: 'https://streamfetch.app/about',
};
---

<Layout
  title="About Us — StreamFetch YouTube Video Downloader"
  description="Discover the mission, technology, and engineering architecture behind StreamFetch, the minimalist, zero-ad YouTube video and audio downloader."
  canonicalUrl="https://streamfetch.app/about"
  jsonLd={aboutJsonLd}
>
  <Navbar />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 w-full">
    <!-- Breadcrumb & Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] text-[#171717] mb-3 shadow-xs">
        <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">Engineering & Mission</span>
      </div>
      <h1 class="heading-lg text-[#171717] mb-3">
        About StreamFetch
      </h1>
      <p class="text-sm sm:text-base text-[#4d4d4d] leading-relaxed">
        Building a clean, developer-grade media extraction utility without ads, tracking, or software bloat.
      </p>
    </div>

    <div class="space-y-8 text-sm sm:text-base text-[#4d4d4d] leading-relaxed">
      <!-- Mission Card -->
      <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
        <h2 class="heading-md text-[#171717] mb-3">Our Core Mission</h2>
        <p class="mb-4">
          For years, downloading video or audio from the internet has been synonymous with compromised user experiences. Typical media converters are plagued by misleading download buttons, aggressive pop-under advertisements, malware risks, and artificial download queues designed to push users toward paid subscriptions.
        </p>
        <p>
          StreamFetch was created to provide a modern, ethical alternative. Inspired by modern minimalist design systems and developer platforms, our goal is straightforward: provide instant access to publicly available YouTube media streams with maximum fidelity, zero trackers, and absolute transparency about what our technology does.
        </p>
      </section>

      <!-- Architecture Card -->
      <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
        <h2 class="heading-md text-[#171717] mb-3">How Our Technology Works</h2>
        <p class="mb-4">
          Modern media delivery on YouTube does not store 1080p, 1440p, or 4K videos as single, pre-combined files. Instead, YouTube uses Dynamic Adaptive Streaming over HTTP (DASH), segregating video and audio into independent tracks.
        </p>
        <p class="mb-4">
          Many online converters resolve this by downloading files to disk, slowly transcoding them, and serving compressed results. StreamFetch implements a real-time stream piping architecture:
        </p>
        <ul class="space-y-2.5 my-4 text-xs sm:text-sm text-[#171717]">
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] mt-2 shrink-0"></span>
            <span><strong>Manifest Inspection:</strong> When you submit a URL, we query YouTube's InnerTube manifest directly to determine all valid progressive and adaptive stream options.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] mt-2 shrink-0"></span>
            <span><strong>Lossless In-Memory Remuxing:</strong> For 1080p Full HD video, we fetch the H.264 video track and AAC audio track simultaneously, merging them via FFmpeg stream copy (<code>-c copy</code>). There is zero recompression, eliminating visual quality loss.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] mt-2 shrink-0"></span>
            <span><strong>Chunked Direct Delivery:</strong> Rather than saving hundreds of megabytes on our server, chunks are streamed directly into your browser's download manager in real time.</span>
          </li>
        </ul>
      </section>

      <!-- Privacy & Principles -->
      <section class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
        <h2 class="heading-md text-[#171717] mb-3">Our Guiding Principles</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
          <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">Zero Logging & Privacy</h3>
            <p class="text-xs text-[#8f8f8f] leading-normal">
              We do not track user identities, log URLs against IP addresses, or store download histories. The server functions strictly as an ephemeral pipeline.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">Authentic Quality Reporting</h3>
            <p class="text-xs text-[#8f8f8f] leading-normal">
              We never upscale low-resolution files to fake 1080p. If a video is only available in 720p or 480p, we show the genuine available options.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">Cross-Platform Standard</h3>
            <p class="text-xs text-[#8f8f8f] leading-normal">
              Compatible across Windows, Mac, Linux, Android, and iOS Safari without third-party extension or application installation.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-1">Respect for Creators</h3>
            <p class="text-xs text-[#8f8f8f] leading-normal">
              StreamFetch is intended for personal archiving, education, and permitted use. We encourage users to support creators on their native platforms.
            </p>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <div class="text-center pt-4">
        <a
          href="/#downloader"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#171717] hover:bg-black text-white text-xs sm:text-sm font-medium tracking-tight transition-all active:scale-[0.98] shadow-xs"
        >
          <span>Try the Downloader Tool</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

