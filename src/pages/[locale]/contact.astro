---
// src/pages/[locale]/contact.astro
import ContactPageView from '../../components/ContactPageView.astro';
import {
  SUPPORTED_LOCALES,
  type SupportedLocale,
  DEFAULT_LOCALE,
} from '../../i18n/locales';

export const prerender = false;

const { locale } = Astro.params;

if (!locale || !SUPPORTED_LOCALES.includes(locale as SupportedLocale) || locale === DEFAULT_LOCALE) {
  return Astro.redirect('/contact');
}
---

<ContactPageView locale={locale as SupportedLocale} />

