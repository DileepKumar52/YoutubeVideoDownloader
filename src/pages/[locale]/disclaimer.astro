---
// src/pages/[locale]/disclaimer.astro
import DisclaimerPageView from '../../components/DisclaimerPageView.astro';
import {
  SUPPORTED_LOCALES,
  type SupportedLocale,
  DEFAULT_LOCALE,
} from '../../i18n/locales';

export const prerender = false;

const { locale } = Astro.params;

if (!locale || !SUPPORTED_LOCALES.includes(locale as SupportedLocale) || locale === DEFAULT_LOCALE) {
  return Astro.redirect('/disclaimer');
}
---

<DisclaimerPageView locale={locale as SupportedLocale} />

