---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const contactJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact YouTube Video Downloader Support & Feedback',
  description: 'Get in touch with the YouTube Video Downloader team for technical support, stream bug reports, or feature feedback.',
  url: 'https://youtubevideodownloader.app/contact',
};
---

<Layout
  title="Contact Us — YouTube Video Downloader"
  description="Have a question or encountering an issue with a YouTube stream? Contact the YouTube Video Downloader team for assistance or bug reports."
  canonicalUrl="https://youtubevideodownloader.app/contact"
  jsonLd={contactJsonLd}
>
  <Navbar />

  <main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-12 w-full">
    <!-- Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] text-[#171717] mb-3 shadow-xs">
        <span class="mono-eyebrow text-[11px] text-[#4d4d4d]">Help & Inquiries</span>
      </div>
      <h1 class="heading-lg text-[#171717] mb-3">
        Contact Us
      </h1>
      <p class="text-sm sm:text-base text-[#4d4d4d] leading-relaxed">
        Encountering a playback issue, have a technical question, or want to suggest an improvement? We would love to hear from you.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <!-- Contact Info & Guidelines (1 col) -->
      <div class="space-y-6 md:col-span-1">
        <div class="bg-white border border-[#ebebeb] rounded-2xl p-6 shadow-xs">
          <h2 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-3">Direct Support</h2>
          <div class="space-y-3 text-xs text-[#4d4d4d]">
            <div>
              <div class="text-[#8f8f8f] text-[11px]">Email Support</div>
              <a href="mailto:support@youtubevideodownloader.app" class="font-medium text-[#171717] hover:text-[#0070f3] transition-colors">
                support@youtubevideodownloader.app
              </a>
            </div>
            <div>
              <div class="text-[#8f8f8f] text-[11px]">Response Time</div>
              <div class="font-medium text-[#171717]">Typically within 24–48 hours</div>
            </div>
            <div>
              <div class="text-[#8f8f8f] text-[11px]">Operating Location</div>
              <div class="font-medium text-[#171717]">Open Web Standards Project</div>
            </div>
          </div>
        </div>

        <div class="bg-white border border-[#ebebeb] rounded-2xl p-6 shadow-xs">
          <h2 class="text-xs font-mono font-semibold uppercase text-[#171717] mb-2">Bug Report Tips</h2>
          <p class="text-xs text-[#8f8f8f] leading-relaxed mb-3">
            To help us resolve extraction issues quickly, please include:
          </p>
          <ul class="text-xs text-[#4d4d4d] space-y-1.5 list-disc list-inside">
            <li>The full YouTube video URL</li>
            <li>Requested format (1080p, 720p, or Audio)</li>
            <li>Browser name and version (e.g. Chrome, Safari)</li>
            <li>Your operating system (Windows, Mac, iOS, Android)</li>
          </ul>
        </div>
      </div>

      <!-- Contact Form (2 cols) -->
      <div class="md:col-span-2">
        <div class="bg-white border border-[#ebebeb] rounded-2xl p-6 sm:p-8 shadow-xs">
          <h2 class="heading-md text-[#171717] mb-2">Send a Message</h2>
          <p class="text-xs text-[#8f8f8f] mb-6">
            Fill out the form below. We will review your inquiry and follow up promptly.
          </p>

          <form id="contact-form" class="space-y-4" onsubmit="return false;">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-medium text-[#171717] mb-1.5">
                  Your Name <span class="text-[#ee0000]">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Alex Smith"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-[#ebebeb] bg-[#fafafa] focus:bg-white focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] text-xs text-[#171717] transition-all"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-medium text-[#171717] mb-1.5">
                  Email Address <span class="text-[#ee0000]">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-[#ebebeb] bg-[#fafafa] focus:bg-white focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] text-xs text-[#171717] transition-all"
                />
              </div>
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-medium text-[#171717] mb-1.5">
                Topic / Subject <span class="text-[#ee0000]">*</span>
              </label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-[#ebebeb] bg-[#fafafa] focus:bg-white focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] text-xs text-[#171717] transition-all cursor-pointer"
              >
                <option value="stream-error">Stream / Download Issue with a Specific URL</option>
                <option value="feature-request">Feature Request / Format Suggestion</option>
                <option value="legal">Copyright / Legal / DMCA Inquiry</option>
                <option value="general">General Question or Feedback</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-medium text-[#171717] mb-1.5">
                Message <span class="text-[#ee0000]">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Describe your question or issue in detail..."
                class="w-full px-3.5 py-2.5 rounded-xl border border-[#ebebeb] bg-[#fafafa] focus:bg-white focus:outline-none focus:border-[#171717] focus:ring-1 focus:ring-[#171717] text-xs text-[#171717] transition-all"
              ></textarea>
            </div>

            <!-- Form Status / Feedback Alert -->
            <div id="contact-status" class="hidden p-3 rounded-xl text-xs"></div>

            <button
              id="contact-submit-btn"
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-[#171717] hover:bg-black text-white text-xs font-medium tracking-tight transition-all active:scale-[0.98] shadow-xs cursor-pointer"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !message) {
        statusDiv.className = 'p-3 rounded-xl text-xs bg-[#fff5f5] border border-[#fecaca] text-[#b91c1c]';
        statusDiv.textContent = 'Please fill out all required fields before submitting.';
        statusDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      // Simulating immediate client feedback and confirmation
      setTimeout(() => {
        statusDiv.className = 'p-3 rounded-xl text-xs bg-[#f0fdf4] border border-[#bbf7d0] text-[#166534]';
        statusDiv.innerHTML = '<strong>Message Received!</strong> Thank you for your feedback. We have recorded your note and will review it shortly.';
        statusDiv.classList.remove('hidden');
        form.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Another Message';
      }, 600);
    });
  }
</script>

